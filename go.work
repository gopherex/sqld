go 1.25.0

use (
	.
	./cmd/sqld-gen-bob
)

// Build cmd/sqld-gen-bob against the root module's source for local dev and CI.
// The replace lives here, in go.work, NOT in cmd/sqld-gen-bob/go.mod: end-user
// `go install .../cmd/sqld-gen-bob@vX` ignores the workspace and rejects a
// go.mod that carries a replace directive, so installs fall back to the pinned
// `require github.com/gopherex/sqld vX.Y.Z`. It is version-specific (the root is
// also `use`d, which forbids an all-versions replace) and must match
// cmd/sqld-gen-bob's require — `make release` keeps both in lockstep.
replace github.com/gopherex/sqld v1.1.1 => ./
